# ==========================================
# SellerAgent — 环境变量模板
# 复制此文件为 .env 并填入你的真实 Key
# ==========================================

# DashScope API Key (阿里云灵积) — 必填
# 获取地址: https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# LLM 模型选择: qwen-turbo / qwen-plus / qwen-max
LLM_MODEL_NAME=qwen-plus

# Embedding 模型 (DashScope API，无需本地模型)
EMBEDDING_MODEL=text-embedding-v3

# Reranker 精排模型（仅启用 Reranker 时需要，当前默认关闭）
# 如需启用：取消注释并修改 milvus_client.py:hybrid_search() 最后一步为 _rerank()
# RERANKER_MODEL=BAAI/bge-reranker-base

# Milvus Lite 向量数据库路径
MILVUS_DB_PATH=./milvus_data/seller_kb.db
MILVUS_COLLECTION_NAME=seller_knowledge

# Docling 启动预热（默认 true）
# - 大内存服务器（≥6G）保持默认：启动即加载解析模型，传 PDF 快
# - 小内存服务器（≤2G，只收 Markdown 时用不上 Docling）：设 false 跳过预热，内存从 ~6G 降到 ~1-2G
DOCLING_PREWARM=true

# 服务端口（需同步修改 run.py）
PORT=8080

# HuggingFace Token（上传文件解析需要，Docling 内部 CAS 服务认证）
# 免费申请: https://huggingface.co/settings/tokens → Create new token (类型选 Read)
HF_TOKEN=your-huggingface-token-here

# ── 企业微信「微信客服」接入 ──
# 获取地址: https://work.weixin.qq.com → 客户联系 → 微信客服 → 创建客服账号
# 回调 URL 配置: 微信客服 → API 管理 → 设置 https://你的域名/api/wecom/callback
# 注意: 需要企业完成微信认证才能使用微信客服
WECOM_CORP_ID=your-corp-id          # 企业 ID（设置 → 我的企业 → 企业信息）
WECOM_APP_SECRET=your-app-secret    # 自建应用 Secret（新规范，推荐用此调微信客服 API）
WECOM_KF_SECRET=your-kf-secret      # 微信客服 Secret（旧方式，未配 APP_SECRET 时回退）
WECOM_TOKEN=your-random-token       # 回调 Token（API 管理里自己填写的随机字符串）
WECOM_ENCODING_AES_KEY=             # 回调密钥（API 管理里自动生成，43位）
WECOM_OPEN_KFID=                    # 客服账号 ID（创建客服账号后获取，多个用逗号分隔）
